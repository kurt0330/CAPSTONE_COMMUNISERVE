# ═══════════════════════════════════════════════════════════════════
#  CommuniServe — environment variables
#  Copy to .env.local and fill in. NEVER commit .env.local.
#  Anything NOT prefixed NEXT_PUBLIC_ is server-only and must never
#  be exposed to the browser (CAPSTONE_DOCS.md §0 rule 4).
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY — bypasses RLS

# ── App ────────────────────────────────────────────────────────────
# Used in SMS/email links. http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Resend (email: customer OTP + provider credentials) ────────────
RESEND_API_KEY=re_your_api_key                    # SERVER ONLY
RESEND_FROM_EMAIL=noreply@communiserve.website           # until a custom domain is verified
RESEND_FROM_NAME="CommuniServe LGU Platform"

# Developer OTP bypass. When email delivery fails, print the 6-digit code to
# the terminal and let registration proceed, so the verification screen is
# testable without a verified sending domain.
#   unset  → ON in development, OFF in production (recommended)
#   true   → force ON    false → force OFF
# MUST be false (or unset) for the pilot and production.
OTP_DEV_BYPASS=

# ── Semaphore.co (SMS: notify provider of a new job request) ───────
# Optional — the app logs a warning and carries on when this is absent.
# Dashboard → Account → API key. Each message costs credits.
SEMAPHORE_API_KEY=your-semaphore-api-key          # SERVER ONLY

# Developer SMS bypass. In development (NODE_ENV=development) SMS payloads
# are printed to the terminal instead of sent, to conserve credits.
#   unset  → log only in development, send live in production
#   true   → send real SMS even in development
FORCE_REAL_SMS=

# ── Provider onboarding ────────────────────────────────────────────
# Temporary password emailed to a provider on approval; they are forced to
# change it at first login.
PROVIDER_TEMP_PASSWORD=CommuniServe@2025!
